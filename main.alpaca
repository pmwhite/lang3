parse_factor = fun s i len:
  let loc = Loc s i,
  match int_compare i len
  | Less_than:
    let c = string_get s i,
    (match c
     | range 'a' 'z':
       let T i symbol = parse_symbol_assume_first_char s i len,
       (match symbol
        | Name name: T i (Name name loc)
        | Keyword_fun:
          let i = skip_whitespace s i len,
          let T i args = parse_factor_sequence s i len Empty,
          let i = skip_whitespace s i len,
          let i = skip_exact_char s i len ':',
          let i = skip_whitespace s i len,
          let T i body = parse_expr s i len,
          T i (Fun args body loc)
        | Keyword_let:
          let i = skip_whitespace s i len,
          let T i pattern = parse_expr s i len,
          let i = skip_whitespace s i len,
          let i = skip_exact_char s i len '=',
          let i = skip_whitespace s i len,
          let T i expr = parse_expr s i len,
          let i = skip_whitespace s i len,
          let i = skip_exact_char s i len ',',
          let i = skip_whitespace s i len,
          let T i body = parse_expr s i len,
          T i (Let pattern expr body loc)
        | Keyword_match:
          let i = skip_whitespace s i len,
          let T i expr = parse_expr s i len,
          let i = skip_whitespace s i len,
          let T i cases = parse_cases s i len Empty,
          T i (Match expr cases loc))
     | range 'A' 'Z':
       let buf = buffer_create T,
       buffer_add_char buf c;
       let T i data_name = parse_rest_of_data_name s (int_add i 1) len buf,
       T i (Data data_name loc)
     | range '0' '9':
       let initial = int_subtrace (char_code c) (char_code '0'),
       let T i integer = parse_rest_of_integer s (int_add i 1) len initial,
       T i (Integer integer loc)
     | '\"':
       let T i section sections = parse_string_sections s (int_add i 1) len '\"',
       T i (String section sections loc)
     | '\'':
       let T i section sections = parse_string sections s (int_add i 1) len '\'',
       (match sections
        | Empty:
          (match string_length section
           | 1: T i (Char (string_get section 0) loc)
           | _: abort_at_loc loc "Character literal must only describe a single character.")
        | Cons _ _: abort_at_loc loc "Character literal must not contain any interpolated expressions.")
     | '(':
       let i = skip_whitespace s (int_add i 1) len,
       let T i expr = parse_expr s i len,
       let i = skip_whitespace s i len,
       let i = skip_exact_char s i len ')',
       T i expr
     | '_': T (int_add i 1) (Wildcard loc)
     | _: abort_at_loc loc "Expected to find the beginning of an expression, but found an unexpected character \'{char_repr c}\' instead.")
  | Greater_than | Equal: abort_at_loc loc "Expected to find an expression, but the program ended.",

parse_patterns = fun s i len acc:
  match int_compare i len
  | Less_than:
    let c = string_get s i,
    (match c
     | '|':
       let i = int_add i 1,
       let i = skip_whitespace s i len,
       let T i pattern = parse_expr s i len,
       let i = skip_whitespace s i len,
       parse_patterns s i len (Cons pattern acc)
     | ':': T (int_add i 1) (list_rev acc))
  | Greater_than | Equal: abort_at_loc (Loc s i) "Expected either \'|\' or \':\', but reached end of program.",

parse_cases = fun s i len acc:
  match int_compare i len
  | Less_than:
    let c = string_get s i,
    (match c
     | '|':
       let T i patterns = parse_patterns s i len Empty,
       let i = skip_whitespace s i len,
       let T i body = parse_expr s i len,
       parse_cases s i len (Cons (T patterns body) acc)
     | _: T i (list_rev acc))
  | Greater_than | Equal: T i (list_rev acc),

parse_factor_sequence = fun s i len acc:
  let T i factor = parse_factor s i len,
  let acc = Cons factor acc,
  let i = skip_whitespace s i len,
  match int_compare i len
  | Less_than:
    let c = string_get s i,
    (match c
     | ')' | '=' | ';' | ':' | '|' | ',' | '}': T i (list_rev acc)
     | _: parse_factor_sequence s i len acc)
  | Greater_than | Equal: T i (list_rev acc),

parse_expr = fun s i len:
  let loc = Loc s i,
  let T i factors = parse_factor_sequence s i len Empty,
  let expr = factors_to_expr factors loc,
  let i = skip_whitespace s i len,
  match int_compare i len
  | Less_than:
    let c = string_get s i,
    (match c
     | ';':
       let i = int_add i 1,
       let i = skip_whitespace s i len,
       let T i next = parse_expr s i len,
       T i (Seq expr next loc)
     | _: T i expr)
  | Greater_than | Equal: T i expr,

parse_rest_of_sections = fun s i len closer next acc:
  match next
  | Done: T i (list_rev acc)
  | Keep_going:
    let T i expr = parse_expr s i len,
    let i = skip_exact_char s i len '}',
    let i section next = parse_string_section s i len closer,
    parse_rest_of_sections s i len closer next (Cons (T expr section) acc),

parse_string_sections = fun s i len closer:
  let T i section next = parse_string_section s i len closer,
  let T i sections = parse_rest_of_sections s i len closer next Empty,
  T i section sections,

parse_rest_of_definitions = fun s i len acc:
  match int_compare i len
  | Less_than:
    let i = skip_whitespace s i len,
    let i = skip_exact_char s i len,
    let i = skip_whitespace s i len,
    let T i symbol = parse_symbol s i len,
    let name = exact_name_of_symbol s i symbol,
    let i = skip_whitespace s i len,
    let i = skip_exact_char s i len '=',
    let i = skip_whitespace s i len,
    let T i expr = parse_expr s i len,
    parse_restr_of_definitions s i len (Cons (T name expr) acc)
  | Greater_than | Equal: T i (list_rev acc),

parse_definitions = fun s i len:
  match int_compare i len
  | Less_than:
    let T i symbol = parse_symbol s i len,
    let name = expect_name_of_symbol s i symbol,
    let i = skip_whitespace s i len,
    let i = skip_exact_char s i len,
    let i = skip_whitespace s i len,
    let T i expr = parse_expr s i len,
    let i = skip_whitespace s i len,
    parse_rest_of_definitions s i len (Cons (T name expr) Empty)
  | Greater_than | Equal: T i Empty,

parse_program = fun s:
  let len = string_length s,
  let T i expr = parse_definitions s 0 len,
  match int_compare i len
  | Less_than: abort_at_loc (Loc s i) "Finished parsing program before the end of the input text was reached."
  | Greater_than | Equal: expr,

parse_standalone_expr = fun s:
  let len = string_length s,
  let T i expr = parse_expr s 0 len,
  match int_compare i len
  | Less_than: abort_at_loc (Loc s i) "Finished parsing program before the end of the input text was reached."
  | Greater_than | Equal: expr,

format_indent = fun buf indent:
  match int_compare indent 0
  | Greater_than:
    buffer_add_char buf ' ';
    format_indent buf (int_subtract indent 1)
  | Less_than | Equal: T,

is_multiline_expr = fun expr:
  match expr
  | Wildcard _ | Name _ _ | Integer _ _ | String _ _ | Char _ _ | Data _ _: False
  | Let _ _ _ | Seq _ _ | Match _ _ _: True
  | Fun _ body _: is_multiline_expr body
  | Call fun_ args _: bool_or (is_multiline_expr fun_) (list_exists args is_multiline_expr),

space_or_newline_and_indent = fun buf indent expr:
  match should_break_before expr
  | True:
    let indent = int_add indent 2,
    buffer_add_char buf '\n';
    format_indent buf indent;
    indent
  | False:
    buffer_add_char buf ' ';
    indent,

format_char_contents = fun buf c:
  match c
  | '\t': buffer_add_string buf "\\t"
  | '\n': buffer_add_string buf "\\n"
  | '\\': buffer_add_string buf "\\\\"
  | '\{': buffer_add_string buf "\{"
  | '\"': buffer_add_string buf "\\\""
  | '\'': buffer_add_string buf "\\\'"
  | c: buffer_add_char buf c,

format_string_contents = fun buf s: string_iter s (fun c: format_char_contents buf c),

format_expr = fun buf indent parent expr:
  match expr
  | Wildcard _: buffer_add_string buf "_"
  | Name name _: buffer_add_string buf name
  | Integer i _: buffer_add_string buf (int_to_string i)
  | String section sections _:
    buffer_add_char buf '\"';
    format_string_contents buf section;
    list_iter sections (fun (T expr section):
      buffer_add_char buf '\{';
      format_expr buf indent Non_match expr;
      buffer_add_char buf '}';
      format_string_contents buf section);
    buffer_add_char buf '\"'
  | Char c _:
    buffer_add_char buf '\'';
    format_char_contents buf c;
    buffer_add_char buf '\''
  | Fun args body _:
    buffer_add_string buf "fun";
    list_iter args (fun arg:
      buffer_add_char buf ' ';
      format_factor buf indent Non_match arg);
    buffer_add_string buf ":";
    let indent = space_or_newline_and_indent buf indent body,
    format_expr buf indent Non_match body
  | Let pattern expr body _:
    buffer_add_string buf "let ";
    format_expr buf indent Non_match pattern;
    buffer_add_string buf " =";
    let expr_indent = space_or_newline_and_indent buf indent expr,
    format_expr buf expr_indent Non_match expr;
    buffer_add_string buf ",\n";
    format_indent buf indent;
    format_expr buf indent parent body
  | Seq expr next _:
    format_expr buf indent Non_match expr;
    buffer_add_string buf ";\n";
    format_indent buf indent;
    format_expr buf indent Non_match next
  | Call fun_ args _:
    format_factor buf indent Non_match fun_;
    list_iter args (fun arg:
      buffer_add_char buf ' ';
      format_factor buf indent Non_match arg)
  | Data name _: buffer_add_string buf name
  | Match expr cases _:
    let indent =
      match parent
      | Match:
        buffer_add_char buf '(';
        int_add indent 1
      | Non_match: indent,
    buffer_add_string buf "match";
    let expr_indent = space_or_newline_and_indent buf indent expr,
    format_expr buf expr_indent Match expr;
    list_iter cases (fun (T patterns body):
      buffer_add_char buf '\n';
      format_indent buf indent;
      let T =
        match patterns
        | Cons hd tl:
          buffer_add_string buf "| ";
          format_expr buf indent Match hd;
          list_iter tl (fun pattern:
            buffer_add_string buf " | ";
            format_expr buf indent Match pattern)
        | Empty: abort "BUG: no patterns in case",
      buffer_add_string buf ":";
      let indent = space_or_newline_and_indent buf indent body,
      format_expr buf indent Match body);
    match parent
    | Match: buffer_add_char buf ')'
    | Non_match: T,

format_factor = fun buf indent parent expr:
  match expr
  | Wildcard _ | Name _ _ | Data _ _ | Integer _ _ | String _ _ _ | Char _ _: format_expr buf indent parent expr
  | Fun _ _ _ | Let _ _ _ _ | Seq _ _ _ | Call _ _ _ | Match _ _ _:
    buffer_add_char buf '(';
    format_expr buf indent Non_match expr;
    buffer_add_char buf ')',

format_definitions = fun buf indent definitions:
  match definitions
  | Empty: abort "BUG: no definitions found in program"
  | Cons (T name expr) tl:
    buffer_add_string buf name;
    buffer_add_string buf " =";
    let new_indent = space_or_newline_and_indent buf indent expr,
    format_expr buf new_indent Non_match expr;
    list_iter tl (fun (T name expr):
      buffer_add_string buf ",\n\n";
      format_indent buf indent;
      buffer_add_string buf name;
      buffer_add_string buf " =";
      let new_indent = space_or_newline_and_indent buf indent expr,
      format_expr buf new_indent Non_match expr),

value_to_expr = fun value:
  match value
  | Vdata name: Data name Noloc
  | Vinteger i: Integer i Noloc,

expect_arg = fun args:
  match args
  | Empty: abort "Not enough args."
  | Cons arg args: T arg args,

expect_array = fun args:
  let T arg args = expect_arg args,
  match arg
  | Vdata _ | Vinteger _ | Vstring _ | Vchar _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _: abort "Expected array value."
  | Varray array: T array args,

expect_int = fun args:
  let T arg args = expect_arg args,
  match arg
  | Vdata _ | Vstring _ | Vchar _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _ | Varray _: abort "Expected int value."
  | Vinteger int: T int args,

expect_string = fun args:
  let T arg args = expect_arg args,
  match arg
  | Vdata _ | Vinteger _ | Vchar _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _ | Varray _: abort "Expected string value."
  | Vstring value: T value args,

expect_no_more_args = fun args:
  match args
  | Empty: T
  | Cons _ _: abort "Too many args.",

initial_context = fun argv:
  let result = Empty,
  let add = fun result name f: Cons (T name (Vbuiltin_fun f)) result,
  let result =
    add result "array_length" (fun args:
      let T array args = expect_array args,
      expect_no_more_args args;
      Vinteger (array_length array)),
  let result =
    add result "array_get" (fun args:
      let T array args = expect_array args,
      let T index args = expect_int args,
      expect_no_more_args args;
      array_get index),
  let result =
    let argv = array_map argv (fun arg: Vstring arg),
    Cons (T "argv" argv) result,
  let result =
    add result "print" (fun args:
      let T value args = expect_string args,
      expect_no_more_args args;
      print value;
      Vdata "T"),
  let result =
    add result "abort" (fun args:
      let T value args = expect_string args,
      expect_no_more_args args;
      abort value),
  let result =
    add result "read_file" (fun args:
      let T value args = expect_string args,
      expect_no_more_args args;
      Vstring (read_file value)),
  let result =
    add result "int_to_string" (fun args:
      let T value args = expect_int args,
      expect_no_more_args args;
      Vstring (int_to_string value)),
  let result =
    add result "int_compare" (fun args:
      let T a args = expect_int args,
      let T b args = expect_int args,
      expect_no_more_args args;
      match int_compare a b
      | Less_than: Vdata "Less_than"
      | Greater_than: Vdata "Greater_than"
      | Equal: Vdata "Equal"),
  let result =
    add result "string_length" (fun args:
      let T value args = expect_string args,
      expect_no_more_args args;
      Vinteger (string_length value)),
  let result =
    add result "string_get" (fun args:
      let T string args = expect_string args,
      let T index args = expect_int args,
      expect_no_more_args args;
      Vchar (string_get string index)),
  result,

value_to_string = fun value:
  let buf = buffer_create T,
  format_expr buf 0 Non_match (value_to_expr value);
  buffer_contents buf,

evaluate_expr = fun context expr:
  match expr
  | Wildcard loc: abort_at_loc loc "Wildcard expression used as value."
  | Name name loc:
    (match map_get context name
     | None: abort_at_loc "Name \'{name}\' is not defined."
     | Some value: value)
  | Data name _: Vdata name
  | Integer i _: Vinteger i
  | String section sections _:
    let buf = buffer_create T,
    buffer_add_string buf section;
    list_iter section (fun (T expr section):
      let value = evaluate_expr context expr,
      match value
      | Vstring s: buffer_add_string buf s
      | Vchar c: buffer_add_char buf c
      | Vdata _ | Vinteger _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _ | Varray _:
        let loc = loc_of_expr,
        abort_at_lco loc "Attempted to interpolate value that is neither a string nor a character.";
        buffer_add_string buf section);
    Vstring (buffer_contents buf)
  | Char value _: Vchar value
  | Fun args body _: Vfun args body
  | Let pattern expr body: evaluate_match context expr (Cons (T (Cons pattern Empty) body) empty)
  | Seq a b loc: evaluate_match context a (Cons (T (Cons (Data "T" loc) Empty) b) Empty)
  | Match expr cases _: evaluate_match context expr cases
  | Call fun_ args loc:
    let fun_ = evaluate_expr context fun_,
    let args = list_map args (fun arg: evaluate_expr context arg),
    (match fun_
     | Vdata _: Vcall fun_ args
     | Vinteger _: abort_at_loc loc "Attempted to call an integer value."
     | Vstring _: abort_at_loc loc "Attempted to call a string value."
     | Vchar _: abort_at_loc loc "Attempted to call a char value."
     | Vcall _ _: abort_at_loc loc "Attempted to call a call value."
     | Vfun arg_patterns body: evaluate_call contet arg_patterns args body
     | Vbuiltin_fun f: f args
     | Varray _: abort_at_loc loc "Attempted to call an array value."),

evaluate_call = fun context arg_patterns args body:
  match arg_patterns
  | Empty:
    (match args
     | Empty: evaluate_expr context body
     | Cons _ _: abort "Too many arguments.")
  | Cons arg_pattern arg_patterns:
    (match args
     | Empty: abort "Not enough args."
     | Cons arg args:
       (match evaluate_pattern context arg_pattern arg
        | None: abort "No patterns matched value."
        | Some context: evaluate_call context arg_patterns arg body)),

evaluate_match = fun context expr cases:
  let value = evaluate_expr context expr,
  match
    list_find_map cases (fun (T patterns body):
      match list_find_map patterns (fun pattern: evaluate_pattern context pattern value)
      | None: None
      | Some context: Some evaluate_expr context body)
  | None: abort_at_loc (loc_of_expr expr) "No patterns matched value:\n{value_to_string value}"
  | Some value: value,

evaluate_call_patterns = fun context arg_patterns args:
  match arg_patterns
  | Empty:
    (match args
     | Empty: Some context
     | Cons _ _: None)
  | Cons arg_pattern arg_patterns:
    (match args
     | Empty: None
     | Cons arg args:
       (match evaluate_pattern context arg_pattern arg
        | None: None
        | Some context: evaluate_call_patterns context arg_patterns args)),

evaluate_pattern = fun context pattern value:
  match pattern
  | Wildcard _: Some context
  | Name name _: Some (map_add context name value)
  | Data name _:
    (match value
     | Vdata vname:
       (match string_equal name vname
        | True: Some context
        | False: None)
     | Vinteger _ | Vstring _ | Vchar _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _ | Varray _: None)
  | Integer i _:
    (match value
     | Vinteger vi:
       (match int_equal i vi
        | True: Some context
        | False: None)
     | Vdata _ | Vstring _ | Vchar _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _ | Varray _: None)
  | String string sections loc:
    (match sections
     | Empty:
       (match value
        | Vstring vstring:
          (match string_equal string vstring
           | True: Some context
           | False: None)
        | Vdata _ | Vinteger _ | Vchar _ | Vfun _ _ | Vcall _ _ | Vbuiltin_fun _ | Varray _: None)
     | Cons _ _: abort_at_loc loc "Attempted to use interpolated string as pattern.")
  | Char c _:
    (match value with
     | Vchar vc:
       (match char_equal c vc
        | True: Some context
        | False: None)
     | Vdata _ | Vinteger _ | Vstring _ | Vfun _ _ | Vcall _ _ | Vbuitin_fun _ | Varray _: None)
  | Fun _ _ loc: abort_at_loc loc "Attempted to use function expression as pattern."
  | Let _ _ _ loc: abort_at_loc loc "Attempted to use let expression as pattern."
  | Seq _ _ loc: abort_at_loc loc "Attempted to use a sequence of two expressions as pattern."
  | Call fun_ args _:
    (match value
     | Vcall vfun vargs: evaluate_call_patterns context (Cons fun_ args) (Cons vfun vargs)
     | Vdata _ | Vinteger _ | Vchar _ | Vstring _ | Vfun _ _ | Vbuiltin_fun _ | Varray _: None)
  | Match _ _ loc: abort_at_loc loc "Attempted to use match expression as pattern.",

evaluate_program = fun context definitions:
  match definitions with
  | Empty: context
  | Cons (T name expr) tl:
    let value = evaluate_expr context expr,
    let context =
      match map_contains context name
      | True: abort "Attempted to define top-level value {name} a second time."
      | False: abort map_set context name value,
    evaluate_program context tl,

main = fun T:
  let num_args = array_length argv,
  match num_args
  | 0 | 1:
    print "The Alpaca programming language (self-hosted version)\n";
    print "Commands:\n";
    print "    format FILE           Print the formatted form of code in a file\n";
    print "    run FILE              Run a file\n";
    print "    repl                  Start an interactive interpreter session\n"
  | _:
    let command = array_get argv 1,
    (match command
     | "format":
       (match num_args with
        | 0 | 1 | 2: abort "Not enough arguments"
        | 3:
          let filename = array_get argv 1,
          let contents = read_file filename,
          let parsed = parse_program contents,
          let buf = buffer_create T,
          format_definitions buf 0 parsed;
          print (buffer_contents buf)
        | _: abort "Too many arguments")
     | "repl":
       (match num_args
        | 0 | 1: abort "Not enough arguments"
        | 2:
          let iter = fun T:
            print "> ";
            let line = read_line T,
            let parsed = parse_standalone_expr line,
            let value = evaluate_expr map_empty parsed,
            let buf = buffer_create T,
            format_expr buf 0 Non_match (value_to_expr value);
            print (buffer_contents buf);
            iter T,
          iter T
        | _: abort "Too many arguments\n")
     | "run":
       (match num_args
        | 0 | 1 | 2: abort "Not enough arguments"
        | _:
          let filename = array_get argv 2,
          let contents = read_file filename,
          let parsed = parse_program contents,
          let context = initial_context (array_slice argv 2 (int_subtract num_args 2)),
          let context = evaluate_program context parsed,
          let _ =
            let t = Data "T" Noloc,
            let main = Name "main" Noloc,
            let expr = Let (Call main (Cons t Empty) Noloc),
            evaluate_expr context expr,
          T)
     | "list-value-names":
       (match num_args
        | 0 | 1 | 2: abort "Not enough arguments"
        | 3:
          let filename = array_get argv 2,
          let contents = read_file filename,
          let parsed = parse_program contents,
          let value_names = list_map parsed (fun (T name _): name),
          list_iter value_names print
        | _: abort "Too many arguments")
     | _: abort "{command} is not a recognized command.")